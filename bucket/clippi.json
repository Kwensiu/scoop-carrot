{
    "version": "0.3.6",
    "description": "Lightweight clipboard manager built with Rust and GPUI",
    "homepage": "https://github.com/Ruszero01/clippi",
    "license": "MIT",
    "architecture": {
        "64bit": {
            "url": "https://github.com/Ruszero01/clippi/releases/download/v0.3.6/clippi-x86_64-pc-windows-msvc.zip",
            "hash": "80e6a33746968356f6f16dc10684833aadf876a6294797416174e68adea92511"
        }
    },
    "bin": "clippi.exe",
    "shortcuts": [
        [
            "clippi.exe",
            "Clippi"
        ]
    ],
    "pre_install": [
        "foreach ($file in @('clippi.toml', 'clippi.db', 'clippi.log')) { if (!(Test-Path \"$dir\\$file\")) { New-Item -ItemType File -Path \"$dir\\$file\" | Out-Null } }",
        "if (!(Test-Path \"$dir\\images\")) { New-Item -ItemType Directory -Path \"$dir\\images\" | Out-Null }"
    ],
    "persist": [
        "clippi.toml",
        "clippi.db",
        "images",
        "clippi.log"
    ],
    "checkver": "github",
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/Ruszero01/clippi/releases/download/v$version/clippi-x86_64-pc-windows-msvc.zip"
            }
        },
        "hash": {
            "url": "$url.sha256",
            "regex": "([a-fA-F0-9]{64})"
        }
    }
}
